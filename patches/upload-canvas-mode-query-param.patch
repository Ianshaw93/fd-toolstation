diff --git a/utils/modeFromUrl.js b/utils/modeFromUrl.js
new file mode 100644
index 0000000..93e6a9b
--- /dev/null
+++ b/utils/modeFromUrl.js
@@ -0,0 +1,24 @@
+import { MODE_PERSISTENCE, isDbBacked } from '../store/persistenceModes'
+
+/**
+ * Deep-link bootstrap for Upload Canvas modes.
+ * `/?mode=efs` (also fdsGen | radiation | timeEq) lands in that part
+ * instead of the default fdsGen shell.
+ */
+export function modeFromSearch(search) {
+  if (!search) return null
+  const query = search.startsWith('?') ? search.slice(1) : search
+  const mode = new URLSearchParams(query).get('mode')
+  if (mode && MODE_PERSISTENCE[mode]) return mode
+  return null
+}
+
+export function bootFromModeParam(search) {
+  const mode = modeFromSearch(search)
+  if (!mode) return null
+  return {
+    mode,
+    showModePopup: false,
+    showUploadScreen: !isDbBacked(mode),
+  }
+}
