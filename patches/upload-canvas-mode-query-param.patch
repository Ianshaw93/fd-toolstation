Date: Thu, 17 Sep 2026 19:51:33 +0000
Subject: [PATCH] Add ?mode= deep-link bootstrap for Upload Canvas parts.

/?mode=efs (also fdsGen, radiation, timeEq) skips Choose Mode and
lands in that registered part so toolstation search can open External
Fire Spread rather than the canvas shell.
---
 __tests__/mode-from-url.test.js | 42 +++++++++++++++++++++++++++++++++
 pages/index.jsx                 | 12 ++++++++++
 utils/modeFromUrl.js            | 24 +++++++++++++++++++
 3 files changed, 78 insertions(+)
 create mode 100644 __tests__/mode-from-url.test.js
 create mode 100644 utils/modeFromUrl.js

diff --git a/__tests__/mode-from-url.test.js b/__tests__/mode-from-url.test.js
new file mode 100644
index 0000000..7ce8377
--- /dev/null
+++ b/__tests__/mode-from-url.test.js
@@ -0,0 +1,42 @@
+import { describe, it, expect } from 'vitest'
+import { bootFromModeParam, modeFromSearch } from '../utils/modeFromUrl'
+
+describe('modeFromSearch', () => {
+  it('reads a registered mode from the query string', () => {
+    expect(modeFromSearch('?mode=efs')).toBe('efs')
+    expect(modeFromSearch('mode=fdsGen')).toBe('fdsGen')
+    expect(modeFromSearch('?foo=1&mode=radiation')).toBe('radiation')
+    expect(modeFromSearch('?mode=timeEq')).toBe('timeEq')
+  })
+
+  it('ignores missing or unknown modes', () => {
+    expect(modeFromSearch('')).toBeNull()
+    expect(modeFromSearch('?q=efs')).toBeNull()
+    expect(modeFromSearch('?mode=nope')).toBeNull()
+    expect(modeFromSearch(undefined)).toBeNull()
+  })
+})
+
+describe('bootFromModeParam', () => {
+  it('sends scratch modes (efs, radiation) to the upload screen and skips the mode popup', () => {
+    expect(bootFromModeParam('?mode=efs')).toEqual({
+      mode: 'efs',
+      showModePopup: false,
+      showUploadScreen: true,
+    })
+    expect(bootFromModeParam('?mode=radiation')).toEqual({
+      mode: 'radiation',
+      showModePopup: false,
+      showUploadScreen: true,
+    })
+  })
+
+  it('sends DB-backed modes to their dashboard, not the upload screen', () => {
+    expect(bootFromModeParam('?mode=fdsGen')).toEqual({
+      mode: 'fdsGen',
+      showModePopup: false,
+      showUploadScreen: false,
+    })
+    expect(bootFromModeParam('?mode=timeEq').showUploadScreen).toBe(false)
+  })
+})
